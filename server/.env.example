# Server and authentication
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/devmind
JWT_SECRET=replace-with-a-long-random-secret
SKIP_OTP_VERIFICATION=false

# AI and email
SARVAM_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=DevMind <onboarding@resend.dev>

# Qdrant Cloud
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=devmind_chunks

# Optional services
RERANKER_PROVIDER=local
REDIS_URL=
CONTACT_NOTIFY_EMAIL=

# Local Chroma, used when both Qdrant settings are empty
CHROMA_HOST=localhost
CHROMA_PORT=8000
